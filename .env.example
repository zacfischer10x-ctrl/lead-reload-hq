# Stripe (paste live or test keys in Netlify UI — never commit real values)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin (/admin/) uses Netlify Identity: no env vars. Allowlisted emails are
# ADMIN_EMAILS in netlify/functions/lib/auth.js. The old ADMIN_*_PASSWORD /
# ADMIN_SESSION_SECRET variables are retired.

# Optional — defaults to the request origin at runtime
SITE_URL=https://lead-reload-hq.netlify.app
