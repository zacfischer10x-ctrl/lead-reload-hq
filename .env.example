# Stripe (paste live or test keys in Netlify UI — never commit real values)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin (/admin/) uses Netlify Identity: no env vars. Allowlisted emails are
# ADMIN_EMAILS in netlify/functions/lib/auth.js. The old ADMIN_*_PASSWORD /
# ADMIN_SESSION_SECRET variables are retired.

# Optional — defaults to the request origin at runtime
SITE_URL=https://lead-reload-hq.netlify.app

# Order confirmation email (see ORDER_EMAIL.md). Names only; real values stay in Netlify.
# Provider is gmail-api (Workspace service account). Unset ORDER_EMAIL_BCC sends no BCC.
ORDER_EMAIL_PROVIDER=gmail-api
ORDER_EMAIL_FROM=Lead Reload HQ <support@leadreloadhq.com>
ORDER_EMAIL_REPLY_TO=support@leadreloadhq.com
GMAIL_IMPERSONATE=support@leadreloadhq.com
GMAIL_SERVICE_ACCOUNT_JSON=
ORDER_EMAIL_BCC=
